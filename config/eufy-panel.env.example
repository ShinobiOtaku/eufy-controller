# Start safely in demo mode. eufy-panel-configure switches this to eufy_ws.
PANEL_PROVIDER=demo
PANEL_NAME=Home security
PANEL_HOST=127.0.0.1
PANEL_PORT=8765
PANEL_DATA_DIR=/var/lib/eufy-panel
EUFY_WS_URL=ws://127.0.0.1:3001
# Leave empty to auto-select a single S380/T8030, or the only HomeBase.
EUFY_STATION_SERIAL=
