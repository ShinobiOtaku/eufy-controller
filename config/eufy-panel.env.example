# Start safely in demo mode. eufy-panel-configure switches this to eufy_ws.
PANEL_PROVIDER=demo
PANEL_NAME=Front door
PANEL_HOST=127.0.0.1
PANEL_PORT=8765
PANEL_DATA_DIR=/var/lib/eufy-panel
EUFY_WS_URL=ws://127.0.0.1:3001
# Leave empty to auto-select a single S380/T8030, or the only HomeBase.
EUFY_STATION_SERIAL=

# Weather can use a town or postcode (resolved once at runtime), or explicit
# coordinates. Set WEATHER_COUNTRY_CODE to avoid ambiguous location matches.
WEATHER_LOCATION=
WEATHER_LOCATION_LABEL=
WEATHER_COUNTRY_CODE=GB
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_CACHE_SECONDS=600
